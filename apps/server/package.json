{
  "name": "@pinar/server",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:edger": "bun scripts/build-edger.ts",
    "build:local": "vite build --config vite.local.config.ts",
    "db:import-d1": "bun scripts/import-d1-export.ts",
    "db:migrate:libsql": "bun scripts/migrate-libsql.ts",
    "edger:dev": "bun scripts/edger-dev.ts",
    "edger:install": "bun scripts/edger-install.ts",
    "dev:cloud": "bun scripts/cloud-local.mjs --serve",
    "dev": "vite dev --host",
    "dev:local": "vite dev --config vite.local.config.ts --host 127.0.0.1 --port 17373 --strictPort",
    "preview": "wrangler dev",
    "prepare:cloud": "bun scripts/cloud-local.mjs",
    "smoke:edger": "deno run --allow-read=dist/edger --allow-env --deny-net --deny-write scripts/edger-smoke.mjs dist/edger",
    "test": "bun test",
    "typecheck": "wrangler types && tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@libsql/client": "0.18.0",
    "@pinar/cli": "workspace:*",
    "@pinar/shared": "workspace:*",
    "@pinar/ui": "workspace:*",
    "@tanstack/ai": "0.63.0",
    "@tanstack/ai-mcp": "0.6.0",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.34",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "aws4fetch": "1.0.20",
    "disposable-email-domains-js": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@modelcontextprotocol/client": "2.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.23",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "nitro": "npm:nitro-nightly@3.0.1-20260810-113911-16ff2809",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "unplugin-icons": "23.0.1",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  }
}
