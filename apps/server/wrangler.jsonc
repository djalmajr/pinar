        "STRIPE_PRICE_BR_STORAGE_5GB_12M": "price_1U5XwIJGVFdtzSCOBh5ZZt5S",
        "STRIPE_PRICE_BR_YEARLY": "price_1U5XomJGVFdtzSCOxtZnslQI",
        "STRIPE_PRICE_FOUNDER": "price_1U5XwDJGVFdtzSCO7ngjKIy0",
