{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pinar",
  "main": "./src/worker-entry.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "pinar.dev", "custom_domain": true },
    { "pattern": "www.pinar.dev", "custom_domain": true }
  ],
  "r2_buckets": [
    { "binding": "PINAR_BUCKET", "bucket_name": "pinar-shots" }
  ],
  "ai": { "binding": "AI" },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@pinar.dev"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pinar-history-v2",
      "database_id": "e9f7e794-0cde-4eb9-8548-c2e3ad45a16a",
      "migrations_dir": "./migrations"
    }
  ],
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": {
    "PRICING_AI_CREDITS_1000_BRL_CENTS": "990",
    "PRICING_AI_CREDITS_1000_USD_CENTS": "299",
    "PRICING_LIFETIME_BRL_CENTS": "12990",
    "PRICING_LIFETIME_USD_CENTS": "3900",
    "PRICING_MONTHLY_BRL_CENTS": "490",
    "PRICING_MONTHLY_USD_CENTS": "299",
    "PRICING_STORAGE_20GB_12M_BRL_CENTS": "2990",
    "PRICING_STORAGE_20GB_12M_USD_CENTS": "799",
    "PRICING_STORAGE_5GB_12M_BRL_CENTS": "990",
    "PRICING_STORAGE_5GB_12M_USD_CENTS": "299",
    "PRICING_YEARLY_BRL_CENTS": "3990",
    "PRICING_YEARLY_USD_CENTS": "1900",
    "STRIPE_PRICE_AI_CREDITS_1000": "price_1U5XwFJGVFdtzSCOR2agCgof",
    "STRIPE_PRICE_BR_AI_CREDITS_1000": "price_1U5XwGJGVFdtzSCO8T2LGEqJ",
    "STRIPE_PRICE_BR_LIFETIME": "price_1U5XwEJGVFdtzSCO8nCcFRSc",
    "STRIPE_PRICE_BR_MONTHLY": "price_1U5XomJGVFdtzSCO0316SVCW",
    "STRIPE_PRICE_BR_STORAGE_20GB_12M": "price_1U5XwKJGVFdtzSCOYszI1KcQ",
    "STRIPE_PRICE_BR_STORAGE_5GB_12M": "price_1U5XwIJGVFdtzSCOBh5ZZt5S",
    "STRIPE_PRICE_BR_YEARLY": "price_1U5XomJGVFdtzSCOxtZnslQI",
    "STRIPE_PRICE_LIFETIME": "price_1U5XwDJGVFdtzSCO7ngjKIy0",
    "STRIPE_PRICE_MONTHLY": "price_1U5XomJGVFdtzSCOqTGr4M7C",
    "STRIPE_PRICE_STORAGE_20GB_12M": "price_1U5XwJJGVFdtzSCOd7ex00cf",
    "STRIPE_PRICE_STORAGE_5GB_12M": "price_1U5XwHJGVFdtzSCOPqyoHW73",
    "STRIPE_PRICE_YEARLY": "price_1U5XomJGVFdtzSCOQPra4ioz"
  }
}
