{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pinar-dev",
  "account_id": "1427e570ac9806fcc2626c20e0d38b3d",
  "main": "./src/worker-entry.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Top-level is local-only. Named environments below own every remote
  // binding and route so a bare deploy cannot overwrite staging/production.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pinar-dev",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "PINAR_BUCKET", "bucket_name": "pinar-dev" }
  ],
  "ai": { "binding": "AI" },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@pinar.dev"]
    }
  ],
  "secrets": {
    "required": ["AUTH_PEPPER", "EXTENSION_ORIGIN", "STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET"]
  },
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": {
    "DEPLOYMENT_ENV": "local",
    "PRICING_AI_CREDITS_500_BRL_CENTS": "990",
    "PRICING_AI_CREDITS_500_USD_CENTS": "299",
    "PRICING_STORAGE_5GB_12M_BRL_CENTS": "2990",
    "PRICING_STORAGE_5GB_12M_USD_CENTS": "799",
    "PRICING_STORAGE_1GB_12M_BRL_CENTS": "990",
    "PRICING_STORAGE_1GB_12M_USD_CENTS": "299",
    "PRICING_YEARLY_BRL_CENTS": "9900",
    "PRICING_YEARLY_USD_CENTS": "2900",
    "STRIPE_PRICE_AI_CREDITS_500": "price_1U5ZSTJGVFdtzSCOysL2A8Ty",
    "STRIPE_PRICE_BR_AI_CREDITS_500": "price_1U5ZSTJGVFdtzSCO2YI9ulOP",
    "STRIPE_PRICE_BR_STORAGE_5GB_12M": "price_1U5ZUcJGVFdtzSCOyrwKWYBK",
    "STRIPE_PRICE_BR_STORAGE_1GB_12M": "price_1U5ZTwJGVFdtzSCOGomGvcBw",
    "STRIPE_PRICE_BR_YEARLY": "price_1UIbaZJGVFdtzSCOsdSDMbp8",
    "STRIPE_PRICE_STORAGE_5GB_12M": "price_1U5ZUcJGVFdtzSCOabxqpqXR",
    "STRIPE_PRICE_STORAGE_1GB_12M": "price_1U5ZTwJGVFdtzSCOl1iqMMKf",
    "STRIPE_PRICE_YEARLY": "price_1UIbaZJGVFdtzSCOlI3nql9o"
  },

  "env": {
    // Staging runs on EdgeR (worker pinar-stg on stg.pinar.dev). edger:install
    // reads this env's vars and required secrets; it has no routes and no
    // crons, so a `wrangler deploy --env staging` cannot take the host or
    // run the daily jobs against the old D1. The empty crons list is
    // deliberate: `triggers` is inheritable, and the top-level one is local.
    "staging": {
      "name": "pinar-stg",
      "triggers": { "crons": [] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pinar-stg",
          "database_id": "24ee4840-f0f3-49ba-b6ce-b99b0050d37e",
          "migrations_dir": "./migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "PINAR_BUCKET", "bucket_name": "pinar-stg" }
      ],
      "ai": { "binding": "AI" },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["noreply@pinar.dev"]
        }
      ],
      "secrets": {
        "required": ["AUTH_PEPPER", "EXTENSION_ORIGIN", "STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET"]
      },
      "vars": {
        "DEPLOYMENT_ENV": "staging",
        "CLOUD_TRIAL_ENABLED": "true",
        "PRICING_AI_CREDITS_500_BRL_CENTS": "990",
        "PRICING_AI_CREDITS_500_USD_CENTS": "299",
        "PRICING_STORAGE_5GB_12M_BRL_CENTS": "2990",
        "PRICING_STORAGE_5GB_12M_USD_CENTS": "799",
        "PRICING_STORAGE_1GB_12M_BRL_CENTS": "990",
        "PRICING_STORAGE_1GB_12M_USD_CENTS": "299",
        "PRICING_YEARLY_BRL_CENTS": "9900",
        "PRICING_YEARLY_USD_CENTS": "2900",
        "STRIPE_PRICE_AI_CREDITS_500": "price_1U5ZSTJGVFdtzSCOysL2A8Ty",
        "STRIPE_PRICE_BR_AI_CREDITS_500": "price_1U5ZSTJGVFdtzSCO2YI9ulOP",
        "STRIPE_PRICE_BR_STORAGE_5GB_12M": "price_1U5ZUcJGVFdtzSCOyrwKWYBK",
        "STRIPE_PRICE_BR_STORAGE_1GB_12M": "price_1U5ZTwJGVFdtzSCOGomGvcBw",
        "STRIPE_PRICE_BR_YEARLY": "price_1UIbaZJGVFdtzSCOsdSDMbp8",
        "STRIPE_PRICE_STORAGE_5GB_12M": "price_1U5ZUcJGVFdtzSCOabxqpqXR",
        "STRIPE_PRICE_STORAGE_1GB_12M": "price_1U5ZTwJGVFdtzSCOl1iqMMKf",
        "STRIPE_PRICE_YEARLY": "price_1UIbaZJGVFdtzSCOlI3nql9o"
      }
    },

    // Production runs on EdgeR too (worker pinar on pinar.dev and
    // www.pinar.dev), with the same rules as staging above.
    "production": {
      "name": "pinar-prd",
      "triggers": { "crons": [] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pinar-prd",
          "database_id": "d9f0f168-9cfe-45a8-8996-c592e5ec6bda",
          "migrations_dir": "./migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "PINAR_BUCKET", "bucket_name": "pinar-prd" }
      ],
      "ai": { "binding": "AI" },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["noreply@pinar.dev"]
        }
      ],
      "secrets": {
        "required": ["AUTH_PEPPER", "EXTENSION_ORIGIN", "STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET"]
      },
      "vars": {
        "DEPLOYMENT_ENV": "production",
        "CLOUD_TRIAL_ENABLED": "true",
        "PRICING_AI_CREDITS_500_BRL_CENTS": "990",
        "PRICING_AI_CREDITS_500_USD_CENTS": "299",
        "PRICING_STORAGE_5GB_12M_BRL_CENTS": "2990",
        "PRICING_STORAGE_5GB_12M_USD_CENTS": "799",
        "PRICING_STORAGE_1GB_12M_BRL_CENTS": "990",
        "PRICING_STORAGE_1GB_12M_USD_CENTS": "299",
        "PRICING_YEARLY_BRL_CENTS": "9900",
        "PRICING_YEARLY_USD_CENTS": "2900",
        "STRIPE_PRICE_AI_CREDITS_500": "price_1U5XwFJGVFdtzSCOR2agCgof",
        "STRIPE_PRICE_BR_AI_CREDITS_500": "price_1U5XwGJGVFdtzSCO8T2LGEqJ",
        "STRIPE_PRICE_BR_STORAGE_5GB_12M": "price_1U5XwKJGVFdtzSCOYszI1KcQ",
        "STRIPE_PRICE_BR_STORAGE_1GB_12M": "price_1U5XwIJGVFdtzSCOBh5ZZt5S",
        "STRIPE_PRICE_BR_YEARLY": "price_1UIbT3JGVFdtzSCOUDeJYbxz",
        "STRIPE_PRICE_STORAGE_5GB_12M": "price_1U5XwJJGVFdtzSCOd7ex00cf",
        "STRIPE_PRICE_STORAGE_1GB_12M": "price_1U5XwHJGVFdtzSCOPqyoHW73",
        "STRIPE_PRICE_YEARLY": "price_1UIbT3JGVFdtzSCOuMsBHBNj"
      }
    }
  }
}
