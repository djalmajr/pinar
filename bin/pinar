#!/bin/sh
set -e
root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
cli="$root/lib/cli.mjs"
if [ ! -f "$cli" ]; then
  cli="$root/src/cli.mjs"
fi
if command -v node >/dev/null 2>&1; then
  exec node "$cli" "$@"
fi
if command -v bun >/dev/null 2>&1; then
  exec bun "$cli" "$@"
fi
echo "pinar: need node or bun on PATH" >&2
exit 1
