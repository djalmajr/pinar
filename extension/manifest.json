{
  "manifest_version": 3,
  "name": "Screen Feedback",
  "version": "0.1.0",
  "description": "Annotate page elements and copy comments, DOM path, and screenshots to the clipboard.",
  "permissions": ["activeTab", "clipboardWrite", "offscreen", "scripting"],
  "host_permissions": ["http://127.0.0.1:17373/*", "<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Screen Feedback",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}