{
  "manifest_version": 3,
  "name": "Pinar",
  "version": "0.1.1",
  "description": "Visual Annotations for AI Agents & Engineers",
  "permissions": ["activeTab", "clipboardWrite", "offscreen", "scripting", "storage"],
  "options_ui": {
    "page": "dist/options.html",
    "open_in_tab": true
  },
  "host_permissions": ["http://127.0.0.1/*", "<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Pinar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}