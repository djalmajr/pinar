{
  "manifest_version": 3,
  "name": "Pinar",
  "version": "0.1.1",
  "description": "Pin comments on page elements and copy them, with DOM path and screenshots, to the clipboard.",
  "permissions": ["activeTab", "clipboardWrite", "downloads", "offscreen", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Pinar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}