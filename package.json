{
  "name": "pinar",
  "version": "0.3.2",
  "description": "Visual Annotations for AI Agents & Engineers",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/cli",
    "apps/extension",
    "apps/server"
  ],
  "bin": {
    "pinar": "./bin/pinar"
  },
  "scripts": {
    "start": "bun apps/cli/src/cli.mjs",
    "serve": "bun apps/cli/src/cli.mjs serve",
    "test": "node --test apps/cli/src/*.test.js extension/*.test.js hooks/*.test.js && bun test apps/extension/src/options/*.test.ts apps/tray/src/bun/*.test.ts packages/shared/src/*.test.ts scripts/*.test.ts && bun --filter @pinar/server test",
    "test:coverage:cli": "node --experimental-test-coverage --test apps/cli/src/*.test.js",
    "test:coverage:extension": "bun test --coverage extension/*.test.js apps/extension/src/options/*.test.ts",
    "test:coverage:server": "bun test --coverage apps/server/src",
    "test:e2e": "bun run build:local && bun run build:ext && playwright test",
    "test:e2e:cloud": "bun run build:ext && playwright test --config playwright.cloud.config.ts",
    "test:e2e:stripe-hosted": "bun scripts/run-stripe-hosted-e2e.mjs",
    "test:e2e:stripe-hosted-catalog": "bun scripts/run-stripe-hosted-catalog-e2e.mjs",
    "test:e2e:stripe-hosted-usd": "bun scripts/run-stripe-hosted-usd-e2e.mjs",
    "test:stripe-sandbox": "bun scripts/stripe-test-catalog-smoke.mjs",
    "capture:help-screenshots": "bun scripts/capture-help-screenshots.mjs",
    "dev:server": "bun --filter @pinar/server dev",
    "dev:cloud": "bun apps/server/scripts/cloud-local.mjs --serve",
    "dev:local": "bun --filter @pinar/server dev:local",
    "prepare:cloud": "bun apps/server/scripts/cloud-local.mjs",
    "build:server": "bun scripts/release-check.mjs && bun --filter @pinar/server build",
    "build:local": "bun --filter @pinar/server build:local",
    "dev:ext": "bun --filter @pinar/extension dev",
    "dev:tray": "bun scripts/prepare-tray-helper.mjs && bun scripts/run-tray.mjs dev",
    "build:tray": "bun scripts/prepare-tray-helper.mjs && bun scripts/run-tray.mjs build",
    "build:ext": "bun scripts/generate-extension-i18n.mjs && bun --filter @pinar/extension build",
    "package:ext": "bun scripts/package-extension.mjs",
    "test:ext": "bun run build:ext && node --test extension/*.test.js && bun test apps/extension/src/options/*.test.ts packages/shared/src/*.test.ts scripts/package-extension.test.ts",
    "build:bin": "bun scripts/build-binaries.mjs",
    "build": "bun run build:server && bun run build:local && bun --filter @pinar/extension build",
    "typecheck": "bun --filter @pinar/server typecheck && tsc --noEmit",
    "release": "bun scripts/release.mjs",
    "release:check": "bun scripts/release-check.mjs --production"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/radix-icons": "^1.2.6",
    "@playwright/test": "^1.62.1",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/vite": "^4.0.6",
    "@types/chrome": "^0.0.308",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "nitro": "npm:nitro-nightly@3.0.1-20260810-113911-16ff2809",
    "tailwindcss": "^4.0.6",
    "typescript": "6.0.3",
    "unplugin-icons": "^22.0.0",
    "vite": "^6.1.0"
  }
}
